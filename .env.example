# Copiar a .env.local y completar con los datos del proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK).
#
# .env.local NO se sube al repositorio. Estos valores igual son públicos:
# identifican al proyecto y no dan permisos. Lo que protege los datos son
# las reglas de firestore.rules.
#
# Para desarrollar con los emuladores alcanza con valores de mentira como
# estos: npm run emu levanta Firestore y Auth en esta máquina.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aurora.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-aurora
VITE_FIREBASE_STORAGE_BUCKET=demo-aurora.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Poner "no" para que npm run dev use el proyecto real en vez de los
# emuladores (por ejemplo, para probar contra datos de verdad).
VITE_FIREBASE_EMULADORES=si
