{
  "name": "catalogo-aurora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run check:dist",
    "catalogo": "node scripts/armar-catalogo.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "emu": "node scripts/emuladores.mjs",
    "todo": "node scripts/todo.mjs",
    "emu:cerrar": "node scripts/cerrar-emulador.mjs",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-aurora \"node tests/reglas.cjs\"",
    "sembrar": "node scripts/sembrar-emulador.mjs",
    "cuenta": "node scripts/alta-cuenta.mjs",
    "publicar": "node scripts/publicar-catalogo.mjs",
    "test:funciones": "node scripts/probar-funciones.mjs",
    "copiar:compartido": "node scripts/copiar-compartido.mjs",
    "arca:certificado": "node scripts/arca-certificado.mjs",
    "desplegar": "firebase deploy --only firestore:rules,firestore:indexes,functions",
    "test:servidor": "vitest run functions/src"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.30.2",
    "globals": "^17.11.0",
    "node-forge": "1.4.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
